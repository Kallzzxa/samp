<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/launcher_bg">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <!-- ══════════ LEFT NAV RAIL ══════════ -->
    <LinearLayout
        android:id="@+id/nav_rail"
        android:layout_width="@dimen/_56sdp"
        android:layout_height="match_parent"
        android:background="@drawable/nav_rail_bg"
        android:orientation="vertical">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="@dimen/_52sdp"
            android:contentDescription="@string/app_name"
            android:scaleType="centerCrop"
            android:src="@drawable/brand_art"
            android:background="@drawable/launcher_img_clip"
            android:clipToOutline="true" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/launcher_stroke" />

        <LinearLayout
            android:id="@+id/tab_favorites"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginTop="@dimen/_8sdp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_heart"
                android:tint="@color/launcher_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.06"
                android:text="@string/tab_favorites"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_6ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_internet"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_website"
                android:tint="@color/launcher_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.06"
                android:text="@string/tab_internet"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_6ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_recent"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_40sdp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_tab_recent"
                android:tint="@color/launcher_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_3sdp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.06"
                android:text="@string/tab_recent"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_6ssp" />

        </LinearLayout>

        <Space
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/launcher_stroke" />

        <LinearLayout
            android:id="@+id/tab_mods"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_mods"
                android:tint="@color/launcher_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.06"
                android:text="@string/tab_mods"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_6ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_offline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_power"
                android:tint="@color/launcher_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.06"
                android:text="@string/offline_mode"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_6ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/settings_icon"
                android:tint="@color/launcher_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.06"
                android:text="@string/tab_settings"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_6ssp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/tab_exit"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/_11sdp"
                android:layout_height="@dimen/_11sdp"
                android:src="@drawable/ic_close"
                android:tint="@color/launcher_text_dim" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_2sdp"
                android:fontFamily="@font/montserrat_bold"
                android:letterSpacing="0.06"
                android:text="@string/menu_exit"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_6ssp" />

        </LinearLayout>

    </LinearLayout>

    <!-- ══════════ CONTENT ══════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- top bar: search | nickname | add server -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_36sdp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/_10sdp"
            android:paddingEnd="@dimen/_10sdp">

            <EditText
                android:id="@+id/search_edit_text"
                android:layout_width="0dp"
                android:layout_height="@dimen/_24sdp"
                android:layout_weight="1"
                android:background="@drawable/launcher_input_bg"
                android:drawableStart="@drawable/search_24px"
                android:drawablePadding="@dimen/_6sdp"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingStart="@dimen/_10sdp"
                android:paddingEnd="@dimen/_10sdp"
                android:textColor="@color/launcher_text"
                android:textColorHint="@color/launcher_text_dim"
                android:textSize="@dimen/_9ssp" />

            <LinearLayout
                android:id="@+id/btn_add"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@drawable/launcher_btn_outline"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_8sdp">

                <ImageView
                    android:layout_width="@dimen/_9sdp"
                    android:layout_height="@dimen/_9sdp"
                    android:src="@drawable/ic_add"
                    android:tint="@color/launcher_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_4sdp"
                    android:fontFamily="@font/montserrat_bold"
                    android:letterSpacing="0.08"
                    android:text="@string/add_server"
                    android:textColor="@color/launcher_text"
                    android:textSize="@dimen/_8ssp" />

            </LinearLayout>

            <ImageView
                android:id="@+id/btn_refresh"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_marginStart="@dimen/_6sdp"
                android:background="@drawable/launcher_btn_outline"
                android:contentDescription="@string/refresh"
                android:foreground="?attr/selectableItemBackground"
                android:padding="@dimen/_5sdp"
                android:src="@drawable/ic_restore"
                android:tint="@color/launcher_text" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/launcher_stroke" />

        <!-- list + detail -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/refresh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/servers_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="vertical" />

            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <!-- detail card -->
            <FrameLayout
                android:id="@+id/info_card"
                android:layout_width="@dimen/_190sdp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:layout_marginEnd="@dimen/_8sdp"
                android:layout_marginBottom="@dimen/_8sdp"
                android:background="@drawable/launcher_card">

                <LinearLayout
                    android:id="@+id/info_empty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/_80sdp"
                        android:layout_height="@dimen/_80sdp"
                        android:alpha="0.95"
                        android:contentDescription="@string/app_name"
                        android:src="@drawable/brand_art"
                        android:background="@drawable/launcher_img_clip"
                        android:clipToOutline="true" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_14sdp"
                        android:gravity="center"
                        android:text="@string/select_server_hint"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_8ssp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/info_body"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="@dimen/_10sdp"
                    android:visibility="gone">

                    <androidx.core.widget.NestedScrollView
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:overScrollMode="never">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/info_server_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:fontFamily="@font/montserrat_bold"
                            android:maxLines="2"
                            android:textColor="@color/launcher_text"
                            android:textSize="@dimen/_11ssp" />

                        <ImageView
                            android:id="@+id/btn_favorite"
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginStart="@dimen/_6sdp"
                            android:background="@drawable/launcher_btn_outline"
                            android:contentDescription="@string/add_to_favorites"
                            android:foreground="?attr/selectableItemBackground"
                            android:padding="@dimen/_6sdp"
                            android:src="@drawable/ic_heart"
                            android:tint="@color/launcher_text_dim" />

                        <ImageView
                            android:id="@+id/btn_delete"
                            android:layout_width="@dimen/_26sdp"
                            android:layout_height="@dimen/_26sdp"
                            android:layout_marginStart="@dimen/_5sdp"
                            android:background="@drawable/launcher_btn_danger"
                            android:contentDescription="@string/delete_server"
                            android:foreground="?attr/selectableItemBackground"
                            android:padding="@dimen/_6sdp"
                            android:src="@drawable/ic_delete"
                            android:tint="@color/launcher_danger"
                            android:visibility="gone" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/info_server_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/launcher_accent"
                        android:textSize="@dimen/_8ssp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/_8sdp"
                        android:background="@color/launcher_stroke" />

                    <LinearLayout
                        android:id="@+id/players_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/_3sdp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.12"
                            android:text="@string/column_players"
                            android:textAllCaps="true"
                            android:textColor="@color/launcher_text_dim"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:gravity="end"
                            android:letterSpacing="0.12"
                            android:text="@string/column_score"
                            android:textAllCaps="true"
                            android:textColor="@color/launcher_text_dim"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:layout_width="@dimen/_34sdp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_4sdp"
                            android:gravity="end"
                            android:letterSpacing="0.12"
                            android:text="@string/column_ping"
                            android:textAllCaps="true"
                            android:textColor="@color/launcher_text_dim"
                            android:textSize="@dimen/_8ssp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/players_list"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_96sdp"
                        android:overScrollMode="always" />

                    <TextView
                        android:id="@+id/players_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="@dimen/_8sdp"
                        android:paddingBottom="@dimen/_8sdp"
                        android:text="@string/loading"
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_8ssp" />

                    <LinearLayout
                        android:id="@+id/links_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout
                            android:id="@+id/discord_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_3sdp"
                            android:foreground="?attr/selectableItemBackground"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_9sdp"
                                android:layout_height="@dimen/_9sdp"
                                android:src="@drawable/ic_discord"
                                android:tint="@color/launcher_accent" />

                            <TextView
                                android:id="@+id/discord_text"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/_5sdp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/launcher_text"
                                android:textSize="@dimen/_8ssp" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/rules_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:orientation="horizontal"
                        android:paddingBottom="@dimen/_3sdp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:letterSpacing="0.12"
                            android:text="@string/column_rules"
                            android:textAllCaps="true"
                            android:textColor="@color/launcher_text_dim"
                            android:textSize="@dimen/_8ssp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:letterSpacing="0.12"
                            android:text="@string/column_value"
                            android:textAllCaps="true"
                            android:textColor="@color/launcher_text_dim"
                            android:textSize="@dimen/_8ssp" />

                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rules_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                        </LinearLayout>

                    </androidx.core.widget.NestedScrollView>

                    <LinearLayout
                        android:id="@+id/btn_join"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginTop="@dimen/_6sdp"
                        android:background="@drawable/launcher_btn_primary"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/_11sdp"
                            android:layout_height="@dimen/_11sdp"
                            android:src="@drawable/ic_play"
                            android:tint="@color/launcher_on_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/_8sdp"
                            android:fontFamily="@font/montserrat_bold"
                            android:letterSpacing="0.12"
                            android:text="@string/join_server"
                            android:textAllCaps="true"
                            android:textColor="@color/launcher_on_accent"
                            android:textSize="@dimen/_11ssp" />

                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

    <!-- settings overlay -->
    <FrameLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/launcher_bg"
        android:visibility="gone">

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/settings_fragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</FrameLayout>
