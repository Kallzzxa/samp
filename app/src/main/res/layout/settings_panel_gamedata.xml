<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_gamedata"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/_12sdp"
    android:visibility="gone">

    <!-- Top card: resource overview, version tier, and action buttons (manual only, never auto-downloads) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/launcher_card"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="@dimen/_8sdp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Game Resources &amp; File Verification"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_9ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_gd_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_2sdp"
                    android:text="Checking local game files…"
                    android:textColor="@color/launcher_text"
                    android:textSize="@dimen/_8ssp" />

                <TextView
                    android:id="@+id/tv_gd_storage_meta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_1sdp"
                    android:text="Supports local .zip import or manual lite-resource download via the launcher (the full 2.10 GiB edition currently supports local verification only)"
                    android:textColor="@color/launcher_text_dim"
                    android:textSize="@dimen/_7ssp" />
            </LinearLayout>

            <!-- Resource version tier: Lite (current unified edition) / Full (2.10 GiB verification view) -->
            <com.sampmobile.launcher.ui.widget.GtaOptionView
                android:id="@+id/option_gd_edition"
                android:layout_width="@dimen/_132sdp"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginEnd="@dimen/_6sdp" />

            <TextView
                android:id="@+id/btn_gd_import"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_26sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:background="@drawable/launcher_btn_outline"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:text="Local Import"
                android:textColor="@color/launcher_text"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_gd_download"
                android:tag="theme_accent_bg"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_26sdp"
                android:background="@drawable/launcher_btn_primary"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_10sdp"
                android:text="Launcher Download"
                android:textColor="@color/launcher_on_accent"
                android:textSize="@dimen/_8ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Inline download progress area (expands only after tapping "Launcher Download") -->
        <LinearLayout
            android:id="@+id/layout_gd_download_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_8sdp"
            android:background="@drawable/ui_item_bg"
            android:orientation="vertical"
            android:padding="@dimen/_8sdp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_gd_dl_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="middle"
                    android:singleLine="true"
                    android:text="Connecting to download service…"
                    android:textColor="@color/launcher_text"
                    android:textSize="@dimen/_8ssp" />

                <TextView
                    android:id="@+id/tv_gd_dl_bytes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_8sdp"
                    android:text="0%"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_gd_download"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_6sdp"
                android:layout_marginTop="@dimen/_5sdp"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/ui_progress_mini" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom card: game file list with per-file status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_weight="1"
        android:background="@drawable/launcher_card"
        android:orientation="vertical"
        android:padding="@dimen/_10sdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_gd_list_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="File Checklist"
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_8ssp" />

            <TextView
                android:id="@+id/btn_gd_filter_all"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginEnd="@dimen/_5sdp"
                android:background="@drawable/launcher_btn_primary"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_8sdp"
                android:text="All"
                android:textColor="@color/launcher_on_accent"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_gd_filter_issues"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:background="@drawable/launcher_btn_outline"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_8sdp"
                android:text="Errors Only"
                android:textColor="@color/launcher_text"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btn_gd_verify"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/_22sdp"
                android:background="@drawable/launcher_btn_outline"
                android:gravity="center"
                android:paddingHorizontal="@dimen/_8sdp"
                android:text="Re-verify"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_7ssp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/_6sdp"
            android:layout_marginBottom="@dimen/_4sdp"
            android:background="@color/ui_hairline" />

        <TextView
            android:id="@+id/tv_gd_list_empty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="No files with errors under the current filter"
            android:textColor="@color/launcher_text_dim"
            android:textSize="@dimen/_8ssp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_gd_files"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/_2sdp" />
    </LinearLayout>
</LinearLayout>
