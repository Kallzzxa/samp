<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_logs"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@drawable/ui_scroll_thumb"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/_12sdp">

        <!-- Card: Runtime Status Check -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_14sdp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_diag_status_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Runtime Diagnostics: OK"
                        android:textColor="@color/launcher_accent"
                        android:textSize="@dimen/_10ssp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_diag_status_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/_4sdp"
                        android:lineSpacingExtra="3dp"
                        android:text="The client automatically logs background runtime status."
                        android:textColor="@color/launcher_text_dim"
                        android:textSize="@dimen/_8ssp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btn_log_refresh"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/_26sdp"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/_10sdp"
                    android:text="Re-check"
                    android:textColor="@color/launcher_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Card: One-Tap Feedback &amp; Log Export -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/launcher_card"
            android:orientation="vertical"
            android:padding="@dimen/_14sdp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bug Feedback &amp; Log Export"
                android:textColor="@color/launcher_accent"
                android:textSize="@dimen/_9ssp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_4sdp"
                android:lineSpacingExtra="3dp"
                android:text="If the game crashes, lags, or a mod misbehaves, you don't need to hunt for files -- tap a button below to copy or export feedback info in one tap and send it to the server owner or developer to pinpoint the issue quickly."
                android:textColor="@color/launcher_text_dim"
                android:textSize="@dimen/_8ssp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_12sdp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btn_log_copy_report"
                    android:tag="theme_accent_bg"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1.3"
                    android:background="@drawable/launcher_btn_primary"
                    android:gravity="center"
                    android:text="Copy Bug Feedback Info in One Tap"
                    android:textColor="@color/launcher_on_accent"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_log_share"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_marginEnd="@dimen/_6sdp"
                    android:layout_weight="1"
                    android:background="@drawable/launcher_btn_outline"
                    android:gravity="center"
                    android:text="Export Feedback Log File"
                    android:textColor="@color/launcher_text"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btn_log_clear"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_32sdp"
                    android:layout_weight="0.8"
                    android:background="@drawable/launcher_btn_danger"
                    android:gravity="center"
                    android:text="Clear Log Cache"
                    android:textColor="@color/launcher_danger"
                    android:textSize="@dimen/_8ssp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
